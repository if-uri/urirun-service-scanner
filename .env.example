# Example environment configuration for urirun-service-scanner.
# Copy to .env and adjust values as needed; all values are optional.

# Host address the scanner service binds to (default: 0.0.0.0)
URIRUN_SCANNER_HOST=0.0.0.0

# Port for the scanner service (default: 8196)
URIRUN_SCANNER_PORT=8196

# Set to 0 to disable TLS/HTTPS (default: 1)
URIRUN_SCANNER_HTTPS=1
