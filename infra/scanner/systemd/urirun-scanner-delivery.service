[Unit]
Description=Verified PDF and metadata delivery to Lenovo scan inbox (PLF-031)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/github/if-uri/urirun
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=%h/github/if-uri/urirun/venv/bin/python %h/.config/urirun/scanner-delivery/deliver.py
TimeoutStartSec=10min
